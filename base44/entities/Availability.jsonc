{
  "name": "Availability",
  "type": "object",
  "properties": {
    "team_member": {
      "type": "string",
      "description": "Name of the team member"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Available date"
    },
    "time_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available time slots for this date"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether the team member is available"
    }
  },
  "required": [
    "team_member",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}