{
  "name": "Booking",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Client's full name"
    },
    "client_email": {
      "type": "string",
      "description": "Client's email"
    },
    "client_phone": {
      "type": "string",
      "description": "Client's phone number"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "regular_cleaning",
        "deep_cleaning",
        "inspection",
        "care_services"
      ],
      "description": "Type of service requested"
    },
    "recurring_frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "one_time",
      "description": "How often the service recurs"
    },
    "recurring_discount": {
      "type": "number",
      "description": "Discount percentage applied (0, 10, 15, or 20)"
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional services selected"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Requested date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Requested time slot"
    },
    "address": {
      "type": "string",
      "description": "Property address"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "condo",
        "house",
        "vacation_rental",
        "other"
      ],
      "description": "Type of property"
    },
    "bedrooms": {
      "type": "number",
      "description": "Number of bedrooms"
    },
    "bathrooms": {
      "type": "number",
      "description": "Number of bathrooms"
    },
    "notes": {
      "type": "string",
      "description": "Special instructions or notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "assigned_to": {
      "type": "string",
      "description": "Team member assigned"
    },
    "quote_amount": {
      "type": "number",
      "description": "Price quote set by admin in USD (after discount)"
    },
    "quote_amount_before_discount": {
      "type": "number",
      "description": "Original price before recurring discount"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "quote_sent",
        "paid"
      ],
      "default": "unpaid",
      "description": "Payment status"
    },
    "stripe_payment_link": {
      "type": "string",
      "description": "Stripe payment link URL"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ja"
      ],
      "default": "en"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "service_type",
    "preferred_date"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}